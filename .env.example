# Wind Forecast Analytics - Environment Configuration
PORT=8000

# Elexon BMRS API Base URL
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Default Date Range (Initial Period: January 2026)
DEFAULT_START_DATE=2026-01-01
DEFAULT_END_DATE=2026-01-31

# Default Forecast Cutoff Policy
# Supported options: day_ahead_1700, day_ahead_1200, gate_closure_1h, latest_prior
DEFAULT_CUTOFF_POLICY=day_ahead_1700

# HTTP Client & In-Memory Cache Timeouts
HTTP_TIMEOUT_SECONDS=30.0
CACHE_TTL_SECONDS=3600
